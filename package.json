{
  "name": "@receptron/laya",
  "version": "0.1.2",
  "description": "Run Laya (convaiinnovations/laya), the open-source Jev-compatible System-1 decision model, from Bun via ONNX Runtime",
  "license": "Apache-2.0",
  "author": "receptron",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/laya.git"
  },
  "homepage": "https://github.com/receptron/laya#readme",
  "bugs": {
    "url": "https://github.com/receptron/laya/issues"
  },
  "keywords": [
    "laya",
    "jev",
    "system-one",
    "decision-model",
    "onnx",
    "onnxruntime",
    "modernbert",
    "classification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "bun test ./test/test_download.ts ./test/test_model.ts ./test/test_sequence.ts",
    "format": "prettier --write \"{src,test,examples}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,examples}/**/*.ts\" \"*.{json,md}\"",
    "example:basic": "bun examples/basic.ts",
    "example:debate": "bun examples/debate.ts",
    "download-models": "bun examples/download-models.ts",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-sonarjs": "^4",
    "globals": "^17",
    "prettier": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}